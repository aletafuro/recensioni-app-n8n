# Copia questo file in .env e inserisci la tua chiave.
# Il file .env non va condiviso.

OPENAI_API_KEY=sk-...

# --- facoltativi (i valori qui sotto sono quelli predefiniti) ---

# modello per l'analisi, la scoperta degli aspetti e il digest
# LLM_MODEL=gpt-4.1-mini
# modello per i guardrail con controllo via LLM (manipolazione, nomi nel digest)
# GUARDRAIL_MODEL=gpt-4.1-mini
# endpoint compatibile con l'API OpenAI
# OPENAI_BASE_URL=https://api.openai.com/v1

# file di input, visto dal container: la cartella data/ del progetto e' /files
# INPUT_FILE=/files/input/recensioni_inventate.csv
# OUTPUT_DIR=/files/output

# 0 = tutte le recensioni; un numero > 0 = campione ripetibile per una prova veloce
# LIMIT=0
# recensioni per chiamata nell'analisi
# BATCH_SIZE=5
# recensioni lette per far emergere gli aspetti
# DISCOVERY_SAMPLE=240
# minimo di recensioni per ogni periodo dell'andamento nel tempo
# MIN_REVIEWS_PER_PERIOD=100

# porta dell'interfaccia n8n
# N8N_PORT=5678

# --- collegamento a un'app vera (vedi README) ---
# SCARICA_STORE=true
# APP_STORE_ID=
# paesi dell'App Store da leggere
# STORE_PAESI=it
# GOOGLE_PLAY_PACKAGE=
# GOOGLE_PLAY_CREDENZIALI_B64=
# PLAY_LINGUE=it

# --- Telegram: riassunto, digest e avvisi ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- storico degli store (vedi README) ---
# GOOGLE_PLAY_BUCKET=gs://pubsite_prod_rev_.../reviews/
# APPLE_ISSUER_ID=
# APPLE_KEY_ID=
# APPLE_PAESI=ITA
# chiave .p8 in base64: serve al giro quando il feed pubblico di Apple e' vuoto
# APPLE_P8_B64=
# APPLE_API_GIORNI=45

# --- voto negli store per mercato ---
# VOTO_PAESI=it

# --- avvisi urgenti solo per le recensioni degli ultimi N giorni ---
# AVVISI_GIORNI=14
# false = non aggiornare l'elenco degli aspetti in questo giro (il controllo si scrive lo stesso)
# AGGIORNA_ELENCO=true
# --- avviso a grappolo ---
# GRAPPOLO_MINIMO=3
# GRAPPOLO_GIORNI=7
